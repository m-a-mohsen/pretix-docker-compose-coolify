# Local .env with placeholder values (DO NOT commit secrets to public repos)
# Copy or edit these values for local testing. For production, use Coolify env/secret management.

PRETIX_INSTANCE_NAME=localhost
PRETIX_URL=https://v1.tickets.kulturleben-berlin.de/
PRETIX_CURRENCY=EUR
PRETIX_DATADIR=/data
PRETIX_REGISTRATION=off
PRETIX_LOCALE_DEFAULT=de
PRETIX_TIMEZONE=Europe/Berlin

DB_BACKEND=postgresql
DB_NAME=pretix
DB_USER=pretix
DB_PASSWORD=pretix
DB_HOST=database

MAIL_FROM=no-reply@kulturleben-berlin.de
MAIL_HOST=mail.mediaring.org
MAIL_USER=no-reply@kulturleben-berlin.de
MAIL_PASSWORD=s3nD-it+0ut
MAIL_PORT=587
MAIL_TLS=off
MAIL_SSL=off

REDIS_LOCATION=redis://cache/0
REDIS_SESSIONS=true
CELERY_BACKEND=redis://cache/1
CELERY_BROKER=redis://cache/2

# Celery broker environment variables (some images expect these names)
BROKER_URL=${CELERY_BROKER}
CELERY_BROKER_URL=${CELERY_BROKER}

POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_NAME}
