# Local .env with placeholder values (DO NOT commit secrets to public repos)
# Copy or edit these values for local testing. For production, use Coolify env/secret management.

PRETIX_INSTANCE_NAME=localhost
PRETIX_URL=http://localhost
PRETIX_CURRENCY=EUR
PRETIX_DATADIR=/data
PRETIX_REGISTRATION=off
PRETIX_LOCALE_DEFAULT=de
PRETIX_TIMEZONE=Europe/Berlin

DB_BACKEND=postgresql
DB_NAME=pretix
DB_USER=pretix
DB_PASSWORD=pretix
DB_HOST=database

MAIL_FROM=FROM_MAIL
MAIL_HOST=MAIL_SERVER
MAIL_USER=USERNAME
MAIL_PASSWORD=FOOBAR
MAIL_PORT=587
MAIL_TLS=off
MAIL_SSL=off

REDIS_LOCATION=redis://cache/0
REDIS_SESSIONS=true
CELERY_BACKEND=redis://cache/1
CELERY_BROKER=redis://cache/2

POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_NAME}
