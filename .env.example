# Example .env for Coolify GUI or local development
# Copy this file to `.env` or paste the keys into Coolify's env editor.

# Pretix general
PRETIX_INSTANCE_NAME=localhost
PRETIX_URL=http://example.com
PRETIX_CURRENCY=EUR
PRETIX_DATADIR=/data
PRETIX_REGISTRATION=off
PRETIX_LOCALE_DEFAULT=de
PRETIX_TIMEZONE=Europe/Berlin

# Database (used by pretix and postgres service)
DB_BACKEND=postgresql
DB_NAME=pretix
DB_USER=pretix
# Set a secure password for production
DB_PASSWORD=change_me
DB_HOST=database

# Mail
MAIL_FROM=pretix@example.com
MAIL_HOST=smtp.example.com
MAIL_USER=
MAIL_PASSWORD=
MAIL_PORT=587
MAIL_TLS=off
MAIL_SSL=off

# Redis and Celery
REDIS_LOCATION=redis://cache/0
REDIS_SESSIONS=true
CELERY_BACKEND=redis://cache/1
CELERY_BROKER=redis://cache/2
# Celery broker environment variables (some images expect these names)
BROKER_URL=${CELERY_BROKER}
CELERY_BROKER_URL=${CELERY_BROKER}

# Postgres service credentials mapping (for docker-compose)
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}
POSTGRES_DB=${DB_NAME}
